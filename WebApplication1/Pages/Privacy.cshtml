@page
@model PrivacyModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (Model.ShowTableEmployee.Any())
{
    <!-- Grid of the square -->
    <div class="row g-3">
        @foreach (var table in Model.ShowTableEmployee)
        {
            <!-- square box -->
            <div class="col-md-3 col-sm-4 col-6">
                <div class="table-card card h-100 shadow-sm" 
                     data-bs-toggle="modal" 
                     data-bs-target="#tableModal" 
                     data-table-id="@table.id"
                     data-table-number="@table.number"
                     data-table-seats="@table.seats"
                     data-table-status="@table.status">
                    <div class="card-body text-center">
                        <h3 class="mb-2">Table #@table.number</h3>
                        <span class="badge @(Model.GetStatusBadgeClass(table.status))">
                            @(table.status ?? "Available")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tables available.
    </div>
}


<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <!-- Header do Modal - Apenas título e botão close -->
            <div class="modal-header">
                <h5 class="modal-title" id="tableModalLabel">Table Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
  <!-- here -->
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // when the model opens
        const tableModal = document.getElementById('tableModal');
        tableModal.addEventListener('show.bs.modal', function (event) {

            const button = event.relatedTarget;
            
            const tableId = button.getAttribute('data-table-id');
            const tableNumber = button.getAttribute('data-table-number');
            const tableSeats = button.getAttribute('data-table-seats');
            const tableStatus = button.getAttribute('data-table-status');
        });
    });
</script>


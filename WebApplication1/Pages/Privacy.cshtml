@page
@model PrivacyModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (Model.ShowTableEmployee.Any())
{
    <!-- Grid of the square -->
    <div class="row g-3">
        @foreach (var table in Model.ShowTableEmployee)
        {
            <!-- square box -->
            <div class="col-md-3 col-sm-4 col-6">
                <div class="table-card card h-100 shadow-sm" 
                     data-bs-toggle="modal" 
                     data-bs-target="#tableModal" 
                     data-table-id="@table.id"
                     data-table-number="@table.number"
                     data-table-seats="@table.seats"
                     data-table-status="@table.status">
                    <div class="card-body text-center">
                        <h3 class="mb-2">Table #@table.number</h3>
                        <span class="badge @(Model.GetStatusBadgeClass(table.status))">
                            @(table.status ?? "Available")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tables available.
    </div>
}


<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <!-- Header do Modal -->
            <div class="modal-header">
                <h5 class="modal-title" id="tableModalLabel">Table Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Table Information -->
                <div class="mb-3">
                    <p><strong>Table #<span id="modalTableNumber">-</span></strong> | 
                       Seats: <span id="modalTableSeats">-</span> | 
                       Status: <span id="modalTableStatus" class="badge">-</span></p>
                </div>

                <hr>

                <!-- Add Products Section -->
                <div class="mb-3">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <select class="form-select form-select-sm" id="productSelect">
                                <option value="">Select Product</option>
                                @foreach (var product in Model.Products)
                                {
                                    <option value="@product.id" 
                                            data-name="@product.name" 
                                            data-price="@product.price.ToString("F2")"
                                            data-category="@product.category">
                                        @product.name - @product.price.ToString("F2")€
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control form-control-sm" id="productQuantity" min="1" value="1" placeholder="Qty">
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-primary btn-sm w-100" id="addProductBtn">Add</button>
                        </div>
                    </div>
                </div>

                <!-- Added Products List -->
                <div class="mb-3">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                                <th class="text-center" style="width: 50px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="productsTableBody">
                            <tr id="emptyRow">
                                <td colspan="5" class="text-center text-muted py-3">
                                    No products added
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                <td class="text-end fw-bold" id="totalAmount">0.00€</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="saveOrderBtn">
                    <i class="bi bi-check-circle"></i> Save Order
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/table-modal.css" asp-append-version="true" />
<script src="~/js/table-modal.js" asp-append-version="true"></script>


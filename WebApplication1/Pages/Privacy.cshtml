@page
@model PrivacyModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (Model.ShowTableEmployee.Any())
{
    <!-- Grid of the square -->
    <div class="row g-3">
        @foreach (var table in Model.ShowTableEmployee)
        {
            <!-- square box -->
            <div class="col-md-3 col-sm-4 col-6">
                <div class="table-card card h-100 shadow-sm" 
                     data-bs-toggle="modal" 
                     data-bs-target="#tableModal" 
                     data-table-id="@table.id"
                     data-table-number="@table.number"
                     data-table-seats="@table.seats"
                     data-table-status="@table.status">
                    <div class="card-body text-center">
                        <h3 class="mb-2">Table #@table.number</h3>
                        <span class="badge @(Model.GetStatusBadgeClass(table.status))">
                            @(table.status ?? "Available")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tables available.
    </div>
}


<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <!-- Header do Modal -->
            <div class="modal-header">
                <h5 class="modal-title" id="tableModalLabel">Table Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Table Information -->
                <div class="table-info-section mb-4">
                    <h6 class="text-muted mb-3">Table Information</h6>
                    <div class="row">
                        <div class="col-md-4">
                            <p><strong>Number:</strong> <span id="modalTableNumber">-</span></p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Seats:</strong> <span id="modalTableSeats">-</span></p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Status:</strong> <span id="modalTableStatus" class="badge">-</span></p>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Add Products Section -->
                <div class="add-product-section mb-4">
                    <h6 class="text-muted mb-3">Add Products</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="productSelect" class="form-label">Select Product</label>
                            <select class="form-select" id="productSelect">
                                <option value="">-- Choose Product --</option>
                                @foreach (var product in Model.Products)
                                {
                                    <option value="@product.id" 
                                            data-name="@product.name" 
                                            data-price="@product.price.ToString("F2")"
                                            data-category="@product.category">
                                        @product.name - @product.price.ToString("C") (@product.category)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="productQuantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" id="productQuantity" min="1" value="1">
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-primary w-100" id="addProductBtn">
                                <i class="bi bi-plus-circle"></i> Add
                            </button>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Added Products List -->
                <div class="products-list-section">
                    <h6 class="text-muted mb-3">Added Products</h6>
                    <div class="table-responsive">
                        <table class="table table-hover" id="productsTable">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productsTableBody">
                                <tr id="emptyRow">
                                    <td colspan="6" class="text-center text-muted">
                                        No products added yet
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="table-info fw-bold">
                                    <td colspan="4" class="text-end">Total:</td>
                                    <td id="totalAmount">0.00€</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="saveOrderBtn">
                    <i class="bi bi-check-circle"></i> Save Order
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/table-modal.css" asp-append-version="true" />
<script src="~/js/table-modal.js" asp-append-version="true"></script>


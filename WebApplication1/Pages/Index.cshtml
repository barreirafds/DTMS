@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --primary-dark: #18313F;
            --accent-terracotta: #B26E46;
            --light-cream: #F7EDE1;
            --text-dark: #18313F;
            --text-light: #F7EDE1;
        }
        
        body {
            background: linear-gradient(135deg, var(--primary-dark) 0%, #2a4a5f 50%, var(--primary-dark) 100%);
            background-size: 200% 200%;
            animation: gradientShift 8s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
        }
        
        @@keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
        
        .welcome-container {
            background: var(--light-cream);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(24, 49, 63, 0.4), 0 0 0 3px var(--accent-terracotta);
            padding: 3.5rem 2.5rem;
            max-width: 550px;
            width: 100%;
            text-align: center;
            animation: fadeInUp 0.8s ease-out;
            position: relative;
            overflow: hidden;
        }
        
        .welcome-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--accent-terracotta), #d48a5f, var(--accent-terracotta));
            background-size: 200% 100%;
            animation: shimmer 3s linear infinite;
        }
        
        @@keyframes shimmer {
            0% {
                background-position: -200% 0;
            }
            100% {
                background-position: 200% 0;
            }
        }
        
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .welcome-header {
            margin-bottom: 2rem;
        }
        
        .welcome-icon {
            font-size: 5rem;
            color: var(--accent-terracotta);
            margin-bottom: 1rem;
            animation: pulse 2s infinite;
            display: inline-block;
        }
        
        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.08);
            }
        }
        
        .brand-name {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }
        
        .brand-name i {
            font-size: 2rem;
            color: var(--accent-terracotta);
        }
        
        .brand-name span {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--primary-dark);
            letter-spacing: 0.5px;
        }
        
        .welcome-title {
            font-size: 2.25rem;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 0.75rem;
        }
        
        .welcome-subtitle {
            font-size: 1.1rem;
            color: #5a5a5a;
            margin-bottom: 2.5rem;
            line-height: 1.7;
        }
        
        .login-btn {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--accent-terracotta) 100%);
            border: none;
            padding: 1rem 3rem;
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--light-cream);
            border-radius: 50px;
            box-shadow: 0 10px 30px rgba(24, 49, 63, 0.3);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: transform 0.3s ease;
        }
        
        .login-btn:hover {
            transform: translateY(-3px);
            color: #4A90E2;
        }
        
        .features {
            margin-top: 2.5rem;
            padding-top: 2rem;
            border-top: 2px solid var(--accent-terracotta);
        }
        
        .features-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--primary-dark);
            margin-bottom: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .feature-item {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: var(--text-dark);
            font-size: 1rem;
            transition: all 0.3s ease;
            padding: 0.5rem;
            border-radius: 8px;
        }
        
        .feature-item:hover {
            background-color: rgba(178, 110, 70, 0.1);
            transform: translateX(5px);
        }
        
        .feature-item i {
            margin-right: 0.75rem;
            color: var(--accent-terracotta);
            font-size: 1.25rem;
        }
        
        .feature-item span {
            font-weight: 500;
        }
        
        @@media (max-width: 576px) {
            .welcome-container {
                padding: 2.5rem 1.5rem;
            }
            
            .welcome-title {
                font-size: 1.75rem;
            }
            
            .brand-name span {
                font-size: 1.5rem;
            }
            
            .welcome-icon {
                font-size: 4rem;
            }
            
            .login-btn {
                padding: 0.875rem 2rem;
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <div class="welcome-container">
        <div class="welcome-header">
            <div class="welcome-icon">
                <i class="bi bi-restaurant"></i>
            </div>
            <div class="brand-name">
                <i class="bi bi-speedometer2"></i>
                <span>Restaurant Manager</span>
            </div>
        </div>
        
        <h1 class="welcome-title">Welcome!</h1>
        <p class="welcome-subtitle">
            Restaurant Management System<br/>
            Please log in to access the dashboard
        </p>
        
        <a href="/Login" class="login-btn">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Login with Auth0</span>
        </a>
        
        <div class="features">
            <div class="features-title">Features</div>
            <div class="feature-item">
                <i class="bi bi-table"></i>
                <span>Table Management</span>
            </div>
            <div class="feature-item">
                <i class="bi bi-cart-check"></i>
                <span>Order Control</span>
            </div>
            <div class="feature-item">
                <i class="bi bi-box-seam"></i>
                <span>Product Management</span>
            </div>
        </div>
    </div>
</body>
</html>

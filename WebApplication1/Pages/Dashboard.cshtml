@page
@model DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="bi bi-speedometer2"></i> Admin Dashboard
        </h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tables-tab" data-bs-toggle="tab" data-bs-target="#tables" type="button" role="tab">
                <i class="bi bi-table"></i> Tables
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">
                <i class="bi bi-people"></i> Users
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="products-tab" data-bs-toggle="tab" data-bs-target="#products" type="button" role="tab">
                <i class="bi bi-box-seam"></i> Products
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports" type="button" role="tab">
                <i class="bi bi-file-earmark-text"></i> Reports
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="adminTabsContent">
        <!-- Tables Tab -->
        <div class="tab-pane fade" id="tables" role="tabpanel">
            <div class="row">
                <!-- Create Table Form -->
                <div class="col-lg-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Create New Table</h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ActiveTab" value="tables" />
                                
                                <div class="mb-3">
                                    <label for="TableNumber" class="form-label">Table Number</label>
                                    <input type="text" class="form-control" id="TableNumber" name="TableNumber" 
                                           value="@Model.TableNumber" placeholder="Ex: 5" required>
                                    <span asp-validation-for="TableNumber" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label for="TableSeats" class="form-label">Number of Seats</label>
                                    <input type="number" class="form-control" id="TableSeats" name="TableSeats" 
                                           value="@Model.TableSeats" placeholder="Ex: 4" min="1" required>
                                </div>

                                <div class="mb-3">
                                    <label for="TableStatus" class="form-label">Status</label>
                                    <select class="form-select" id="TableStatus" name="TableStatus">
                                        <option value="Available">Available</option>
                                        <option value="Occupied">Occupied</option>
                                        <option value="Reserved">Reserved</option>
                                        <option value="OutOfService">Out of Service</option>
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-circle"></i> Create Table
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Tables List -->
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-list-ul"></i> All Tables</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.TablesList.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Table #</th>
                                                <th>Seats</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var table in Model.TablesList)
                                            {
                                                <tr>
                                                    <td><strong>#@table.Number</strong></td>
                                                    <td>@table.Seats</td>
                                                    <td>
                                                        <span class="badge" style="@Model.GetStatusBadgeStyle(table.Status)">
                                                            @(table.Status ?? "Available")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a asp-page="/EditTable" asp-route-id="@table.Id" 
                                                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <form method="post" asp-page-handler="Delete" asp-route-id="@table.Id" asp-route-tab="tables"
                                                              class="inline-form" onsubmit="return confirm('Are you sure you want to delete this table?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> No tables created yet.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Tab -->
        <div class="tab-pane fade" id="users" role="tabpanel">
            <div class="row">
                <!-- Create User Form -->
                <div class="col-lg-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-person-plus"></i> Create New User</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="CreateUser">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ActiveTab" value="users" />
                                
                                <div class="mb-3">
                                    <label for="UserName" class="form-label">Username</label>
                                    <input type="text" class="form-control" id="UserName" name="UserName" 
                                           value="@Model.UserName" placeholder="Enter username" required>
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label for="Password" class="form-label">Password</label>
                                    <input type="password" class="form-control" id="Password" name="Password" 
                                           value="@Model.Password" placeholder="Enter password" required>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label for="UserRole" class="form-label">Role</label>
                                    <select class="form-select" id="UserRole" name="UserRole" required>
                                        <option value="">Select a role</option>
                                        <option value="Admin" selected="@(Model.UserRole == "Admin")">Admin</option>
                                        <option value="Employee" selected="@(Model.UserRole == "Employee")">Employee</option>
                                        <option value="Waiter" selected="@(Model.UserRole == "Waiter")">Waiter</option>
                                        <option value="Manager" selected="@(Model.UserRole == "Manager")">Manager</option>
                                    </select>
                                    <span asp-validation-for="UserRole" class="text-danger"></span>
                                </div>

                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-person-plus"></i> Create User
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Users List -->
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-people"></i> All Users</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.UsersList.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Username</th>
                                                <th>Role</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in Model.UsersList)
                                            {
                                                <tr>
                                                    <td><strong>#@user.Id</strong></td>
                                                    <td>@user.Username</td>
                                                    <td>
                                                        <span class="badge bg-success">@user.Role</span>
                                                    </td>
                                                    <td>
                                                        @if (user.Id.HasValue)
                                                        {
                                                            <form method="post"
                                                                  asp-page-handler="DeleteUser"
                                                                  asp-route-id="@user.Id.Value"
                                                                  class="inline-form"
                                                                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="tab" value="users" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> No users created yet.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Tab -->
        <div class="tab-pane fade" id="products" role="tabpanel">
            <div class="row">
                <!-- Create Product Form -->
                <div class="col-lg-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="bi bi-box-seam"></i> Add New Product</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="CreateProduct">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ActiveTab" value="products" />
                                
                                <div class="mb-3">
                                    <label for="ProductName" class="form-label">Product Name</label>
                                    <input type="text" class="form-control" id="ProductName" name="ProductName" 
                                           value="@Model.ProductName" placeholder="Enter product name" required>
                                    <span asp-validation-for="ProductName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label for="ProductDescription" class="form-label">Description</label>
                                    <textarea class="form-control" id="ProductDescription" name="ProductDescription" 
                                              rows="3" placeholder="Enter product description">@Model.ProductDescription</textarea>
                                </div>

                                <div class="mb-3">
                                    <label for="ProductPrice" class="form-label">Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <input type="number" class="form-control" id="ProductPrice" name="ProductPrice" 
                                               value="@Model.ProductPrice" placeholder="0.00" step="0.01" min="0" required>
                                    </div>
                                    <span asp-validation-for="ProductPrice" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label for="ProductCategory" class="form-label">Category</label>
                                    <select class="form-select" id="ProductCategory" name="ProductCategory" required>
                                        <option value="">Select a category</option>
                                        <option value="Food" selected="@(Model.ProductCategory == "Food")">Food</option>
                                        <option value="Beverage" selected="@(Model.ProductCategory == "Beverage")">Beverage</option>
                                        <option value="Dessert" selected="@(Model.ProductCategory == "Dessert")">Dessert</option>
                                        <option value="Appetizer" selected="@(Model.ProductCategory == "Appetizer")">Appetizer</option>
                                    </select>
                                    <span asp-validation-for="ProductCategory" class="text-danger"></span>
                                </div>

                                <button type="submit" class="btn btn-warning w-100 text-dark">
                                    <i class="bi bi-box-seam"></i> Add Product
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Products List -->
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-list-ul"></i> All Products</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.ProductsList.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Name</th>
                                                <th>Description</th>
                                                <th>Price</th>
                                                <th>Category</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var product in Model.ProductsList)
                                            {
                                                <tr>
                                                    <td><strong>#@product.id</strong></td>
                                                    <td><strong>@product.name</strong></td>
                                                    <td>@(product.description ?? "-")</td>
                                                    <td><strong>@product.price.ToString("F2")€</strong></td>
                                                    <td>
                                                        <span class="badge bg-warning text-dark">@product.category</span>
                                                    </td>
                                                    <td>
                                                        <form method="post" asp-page-handler="DeleteProduct" asp-route-id="@product.id" asp-route-tab="products"
                                                              class="inline-form" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> No products created yet.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reports Tab -->
        <div class="tab-pane fade" id="reports" role="tabpanel">
            <div class="row">
                <!-- Filter Form -->
                <div class="col-lg-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filter Orders</h5>
                        </div>
                        <div class="card-body">
                            <form method="get">
                                <input type="hidden" name="handler" value="ViewReport" />
                                <input type="hidden" name="tab" value="reports" />
                                
                                <div class="mb-3">
                                    <label for="StartDate" class="form-label">Start Date</label>
                                    <input type="date" class="form-control" id="StartDate" name="startDate" 
                                           value="@Model.ReportStartDate.ToString("yyyy-MM-dd")" required>
                                </div>

                                <div class="mb-3">
                                    <label for="EndDate" class="form-label">End Date</label>
                                    <input type="date" class="form-control" id="EndDate" name="endDate" 
                                           value="@Model.ReportEndDate.ToString("yyyy-MM-dd")" required>
                                </div>

                                <button type="submit" class="btn btn-info w-100 text-white">
                                    <i class="bi bi-search"></i> View Report
                                </button>
                            </form>
                            
                            @if (Model.ReportOrders.Any())
                            {
                                <hr />
                                <form method="post" asp-page-handler="DownloadReport">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="startDate" value="@Model.ReportStartDate.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="endDate" value="@Model.ReportEndDate.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-download"></i> Download CSV
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>

                <!-- Report Results -->
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-list-ul"></i> Orders Report</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.ShowReport && Model.ReportOrders.Any())
                            {
                                <div class="mb-3">
                                    <p class="mb-0">
                                        <strong>Period:</strong> @Model.ReportStartDate.ToString("dd/MM/yyyy") - @Model.ReportEndDate.ToString("dd/MM/yyyy")
                                        | <strong>Total Orders:</strong> @Model.ReportOrders.Count
                                        | <strong>Total Revenue:</strong> @Model.ReportOrders.Sum(o => o.Total).ToString("F2")€
                                    </p>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Order ID</th>
                                                <th>Table #</th>
                                                <th>Status</th>
                                                <th>Date</th>
                                                <th>Items</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in Model.ReportOrders)
                                            {
                                                <tr>
                                                    <td><strong>#@order.Id</strong></td>
                                                    <td>@order.TableId</td>
                                                    <td>
                                                        <span class="badge @(order.Status == "Paid" ? "bg-success" : order.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                                            @order.Status
                                                        </span>
                                                    </td>
                                                    <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@order.Items.Count</td>
                                                    <td><strong>@order.Total.ToString("F2")€</strong></td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-info">
                                                <td colspan="4" class="text-end"><strong>Total Revenue:</strong></td>
                                                <td colspan="2"><strong>@Model.ReportOrders.Sum(o => o.Total).ToString("F2")€</strong></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                            else if (Model.ShowReport && !Model.ReportOrders.Any())
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> No orders found for the selected date range.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary mb-0">
                                    <i class="bi bi-info-circle"></i> Please select a date range and click "View Report" to see orders.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Activate the correct tab based on URL parameter or ViewData
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const tab = urlParams.get('tab') || '@(ViewData["ActiveTab"] ?? "tables")';
            
            // Remove active class from all tabs and panes
            document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
            document.querySelectorAll('.tab-pane').forEach(pane => {
                pane.classList.remove('show', 'active');
            });
            
            // Activate the correct tab
            const tabButton = document.getElementById(tab + '-tab');
            const tabPane = document.getElementById(tab);
            
            if (tabButton && tabPane) {
                tabButton.classList.add('active');
                tabPane.classList.add('show', 'active');
            } else {
                // Fallback to tables tab if invalid tab name
                document.getElementById('tables-tab')?.classList.add('active');
                document.getElementById('tables')?.classList.add('show', 'active');
            }
        });
    </script>
}

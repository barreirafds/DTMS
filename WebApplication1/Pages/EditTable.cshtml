@page "{id:int}"
@model DTMS.Pages.EditTableModel
@{
    ViewData["Title"] = "Edit Table";
}

<div class="edit-table-container">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary">
                    <h2 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Table
                    </h2>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Number" class="form-label">
                                <i class="bi bi-hash me-1"></i>
                                Number of Table
                            </label>
                            <input asp-for="Number" class="form-control" placeholder="Digite o número da mesa" />
                            <span asp-validation-for="Number" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Seats" class="form-label">
                                <i class="bi bi-people me-1"></i>
                                Seats
                            </label>
                            <input asp-for="Seats" type="number" class="form-control" placeholder="Digite o número de lugares" min="1" />
                            <span asp-validation-for="Seats" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label">
                                <i class="bi bi-info-circle me-1"></i>
                                Status
                            </label>
                            <select asp-for="Status" class="form-select">
                                <option value="Available">Available</option>
                                <option value="Occupied">Occupied</option>
                                <option value="Reserved">Reserved</option>
                                <option value="OutOfService">Out of Service</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-page="/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

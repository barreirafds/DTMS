@page "{id:int}"
@model DTMS.Pages.EditTableModel
@{
    ViewData["Title"] = "Edit Table";
}

<h1>✏️ Edit Table</h1>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="edit-table-form-group">
        <label asp-for="Number"></label><br />
        <input asp-for="Number" />
        <span asp-validation-for="Number"></span>
    </div>

    <div class="edit-table-form-group">
        <label asp-for="Seats"></label><br />
        <input asp-for="Seats" type="number" />
        <span asp-validation-for="Seats"></span>
    </div>

    <div class="edit-table-form-group">
        <label asp-for="Status"></label><br />
        <select asp-for="Status">
            <option value="Available">Available</option>
            <option value="Occupied">Occupied</option>
            <option value="Reserved">Reserved</option>
            <option value="OutOfService">OutOfService</option>
        </select>
        <span asp-validation-for="Status"></span>
    </div>

    <div asp-validation-summary="All"></div>

    <button type="submit" class="edit-table-save-btn">Save</button>
    <a asp-page="/Index" class="edit-table-cancel-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
